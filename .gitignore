# Ignore everything by default.
*

# Local/runtime/generated files remain ignored by default.
*.html
*.env
.env
.venv/
.uv-cache/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.pyc
.DS_Store
*.log
*.tmp
*.bak
.coverage
coverage/
htmlcov/
playwright-report/
test-results/
api_key_memo.txt
sample/
docs/
DESIGN_STYLE.local.md

# Python/runtime data.
backend/*.db*
backend/*.sqlite*
backend/*.sqlite3*
backend/storage/
backend/backend/

# Frontend build/dependency outputs.
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js

# Keep only project essentials.
!.gitignore
!README.md
!DEVELOPMENT_DEFINITION.md
!ERROR_NOTE.md
!sync_raw_to_pdf.py

# Keep selected README assets.
!assets/
assets/*
!assets/readme_overview.png
!assets/vlm_runtime_overview.png

# Keep scripts.
!scripts/
scripts/*
!scripts/run_dev.sh

# Keep backend package, app, and tests.
!backend/
backend/*
!backend/pyproject.toml
!backend/app/
backend/app/*
!backend/app/*.py
!backend/tests/
backend/tests/*
!backend/tests/*.py

# Keep frontend source and build config.
!frontend/
frontend/*
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
frontend/src/*
!frontend/src/*.tsx
!frontend/src/*.ts
!frontend/src/*.css
