# Ignore everything by default.
*

# Repository entrypoints.
!.gitignore
!README.md
!IMPROVEMENT_PLAN.md
!docker-compose.hosting.example.yml

# Runtime examples.
!backend/
backend/*
!backend/.env.production.example
!frontend/
frontend/*
!frontend/.env.production.example

# Backend source.
!backend/pyproject.toml
!backend/Dockerfile
!backend/alembic.ini
!backend/alembic/
backend/alembic/*
!backend/alembic/env.py
!backend/alembic/versions/
backend/alembic/versions/*
!backend/alembic/versions/*.py
!backend/app/
backend/app/*
!backend/app/*.py
!backend/app/prompts/
backend/app/prompts/*
!backend/app/prompts/*.py
!backend/tests/
backend/tests/*
!backend/tests/*.py

# Frontend source.
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/public/
frontend/public/*
!frontend/public/config.js
!frontend/public/sample/
frontend/public/sample/*
!frontend/public/sample/bank_00070.jpg
!frontend/src/
frontend/src/*
!frontend/src/*.ts
!frontend/src/*.tsx
!frontend/src/*.css

# Operator documentation and final README media.
!docs/
docs/*
!docs/api-shape.md
!docs/deployment.md
!docs/recovery-controls.md
!docs/readme-media.html
!assets/
assets/*
!assets/readme/
assets/readme/*
!assets/readme/*.png
!assets/readme/*.mp4
!assets/readme-src/
assets/readme-src/*
!assets/readme-src/*.html
!assets/readme-src/*.css
!assets/readme-src/*.png

# Runnable scripts.
!scripts/
scripts/*
!scripts/run_dev.sh
!scripts/start_hosting_demo.sh
!scripts/stop_hosting_demo.sh

# Always ignored local outputs.
.env
*.env
.venv/
.uv-cache/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.pyc
*.pyo
*.log
*.tmp
*.bak
.DS_Store
.coverage
coverage/
htmlcov/
playwright-report/
test-results/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo
backend/*.db*
backend/*.sqlite*
backend/*.sqlite3*
backend/storage/
