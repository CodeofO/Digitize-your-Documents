{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/.uv-cache/**": true,
    "**/backend/storage/**": true,
    "**/backend/.pytest_cache/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/node_modules/**": true,
    "**/sample/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.uv-cache": true,
    "**/backend/storage": true,
    "**/frontend/dist": true,
    "**/frontend/node_modules": true,
    "**/sample": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "typescript.tsserver.excludeDirectories": [
    "**/.venv",
    "**/.uv-cache",
    "**/backend/storage",
    "**/frontend/dist",
    "**/frontend/node_modules",
    "**/sample"
  ]
}
